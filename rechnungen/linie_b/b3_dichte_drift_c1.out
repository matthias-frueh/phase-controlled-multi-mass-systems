(1) Quelltext drift_balance() (Kopie, unverändert):
    def drift_balance(phi2_deg, phi3_deg, rho=RHO):
        """Gibt (v_d, F_bar_A, tau) zurück.
        v_d      : stationäre Drift aus <(v_d+v_osc)|v_d+v_osc|> = 0  (dichteunabhängig)
        F_bar_A  : -C2*rho*<v_osc|v_osc|>, Gleichrichtungskraft bei vorgegebener Bewegung  <-- rho
        tau      : M/(2*C2*rho*<|v_osc|>), Einschwingzeit der Drift  <-- rho
        """
        v = v_osc_profile(phi2_deg, phi3_deg)
        amp = float(np.max(np.abs(v))) + 1e-9
        vd = brentq(lambda x: float(np.mean((x + v) * np.abs(x + v))), -amp, amp, xtol=1e-15)  <-- v_d: rho kommt nicht vor
        f_bar_a = -C2 * rho * float(np.mean(v * np.abs(v)))  <-- rho
        tau = M_TOTAL / (2 * C2 * rho * float(np.mean(np.abs(v))))  <-- rho
        return vd, f_bar_a, tau

