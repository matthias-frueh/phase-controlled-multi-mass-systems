   gleich        n = 42 (Seed 1): ν_E =  20.83, ν_nom =  19.82; q(1,5) = 0.0061, q(2) = 0.0155, p1 = 2.502e-04; P(u < 0,8) = 0.093 mit Anteil 0.72 an p1
   gleich        n = 61 (Seed 2): ν_E =  30.59, ν_nom =  29.60; q(1,5) = 0.0049, q(2) = 0.0135, p1 = 1.445e-04; P(u < 0,8) = 0.052 mit Anteil 0.51 an p1
